# Copy to .env (or export directly) before running the backend outside of its
# appsettings.Development.json defaults — e.g. for docker-compose Postgres/Redis
# with custom credentials, or a real deployment secret.

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=surbibor;Username=surbibor;Password=surbibor
ConnectionStrings__Redis=localhost:6379

# Must be at least 32 characters. Generate a real secret for anything beyond local dev,
# e.g.: openssl rand -base64 48
Jwt__Secret=dev-only-secret-do-not-use-in-production-min-32-chars
Jwt__Issuer=Surbibor
Jwt__Audience=Surbibor

# Origin the backend's CORS policy allows (the frontend dev server by default).
# Also used as the base URL for links in verification / password-reset emails.
Frontend__Origin=http://localhost:5173

# Outgoing email (verification + password reset). These defaults point at the Mailpit
# container from docker-compose; view sent mail at http://localhost:8025.
# Email__Provider: Smtp (default) or Brevo. Use Brevo on hosts that block outbound SMTP
# (e.g. Railway): set Email__Provider=Brevo, Email__BrevoApiKey and Email__FromAddress;
# the Smtp* settings are then ignored.
# Email__Security: StartTls (587), SslOnConnect (465) or None (local catchers only).
Email__Provider=Smtp
Email__BrevoApiKey=
Email__SmtpHost=localhost
Email__SmtpPort=1025
Email__Security=None
Email__SmtpUsername=
Email__SmtpPassword=
Email__FromAddress=no-reply@surbibor.local
Email__FromName=Surbibor
