# Copy to .env (or export directly) before running the backend outside of its
# appsettings.Development.json defaults — e.g. for docker-compose Postgres/Redis
# with custom credentials, or a real deployment secret.

ConnectionStrings__Postgres=Host=localhost;Port=5432;Database=surbibor;Username=surbibor;Password=surbibor
ConnectionStrings__Redis=localhost:6379

# Must be at least 32 characters. Generate a real secret for anything beyond local dev,
# e.g.: openssl rand -base64 48
Jwt__Secret=dev-only-secret-do-not-use-in-production-min-32-chars
Jwt__Issuer=Surbibor
Jwt__Audience=Surbibor

# Origin the backend's CORS policy allows (the frontend dev server by default).
Frontend__Origin=http://localhost:5173
